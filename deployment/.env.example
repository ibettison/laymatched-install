# LayMatched Auth API & Private Registry Configuration
# Copy to .env and customize for your deployment

# Auth API
PORT=8443
DB_PATH=/data/auth-tokens.db
APPROVED_VERSION=v0.1.0
REGISTRY_URL=registry.laymatched.io
PRIVATE_KEY_PATH=/data/private.pem
PUBLIC_KEY_PATH=/data/public.pem
RATE_LIMIT_PER_MIN=50
LOG_LEVEL=info

# Registry (configured via registry/config.yml)
# No additional env vars needed

# Nginx/TLS
# Certificates managed by Let's Encrypt certbot
# Place certs in deployment/certs/<domain>/
# Or use certbot in nginx container