#!/bin/bash
# Wrapper: create LayMatched data directories with correct ownership
# Usage: laymatched-dir-setup

set -euo pipefail

# All directories root:root - laymatched-deploy has NO write access
DIRS=(
    "/opt/laymatched-auth"
    "/opt/laymatched-auth/data"
    "/opt/laymatched-registry"
    "/opt/laymatched-registry/data"
)

for d in "${DIRS[@]}"; do
    mkdir -p "$d"
    chown root:root "$d"
    chmod 750 "$d"
    echo "Prepared $d (root:root 750)"
done

# Parent directories world-readable but not writable by laymatched-deploy
chmod 755 /opt/laymatched-auth /opt/laymatched-registry

echo "All directories created with root:root ownership"
echo "laymatched-deploy has NO direct write access to production paths"