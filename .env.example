# LayMatched Installer — Example Configuration
# Customer-provided values only. Internal secrets are generated automatically by install.sh.

# GHCR authentication token — provided by customer at install time
# GHCR_TOKEN=<your_ghcr_token_here>

# Application version/tag to install (e.g., latest, v1.2.3)
# APP_VERSION=latest

# PostgreSQL database name (internal — generated by installer)
# POSTGRES_DB=laymatched_betting

# These are generated automatically by the installer and stored in /opt/laymatched/.env
# Do not set these manually unless you know what you are doing:

# DATABASE_URL=postgresql+psycopg://laymatched:<password>@db:5432/laymatched_betting
# AUTH_USERNAME=laymatched
# AUTH_PASSWORD_HASH=pbkdf2_sha256<iterations><salt><hash>
# AUTH_SESSION_SECRET=<random_48_char_urlsafe_base64>
# AUTH_SESSION_HOURS=12
# COMMUNITY_INSTALLATION_KEY=<random_32_char>
# COMMUNITY_ATTRIBUTION_SECRET=<random_32_char>